<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Graft.McpServer</RootNamespace>
    <AssemblyName>Graft.McpServer</AssemblyName>
    <Description>MCP host exposing Graft.Core (stdio transport).</Description>
    <!-- Executable host, not a client library. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Graft.Core\Graft.Core.csproj" />
  </ItemGroup>
</Project>
