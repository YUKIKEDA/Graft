<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Graft.Instrumentation.Wpf</RootNamespace>
    <AssemblyName>Graft.Instrumentation.Wpf</AssemblyName>
    <DefineConstants>$(DefineConstants);GRAFT_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Graft.Instrumentation\Graft.Instrumentation.csproj" />
    <!-- Consumers of the WPF package get GRAFT001 automatically (project.md Q33). -->
    <ProjectReference
      Include="..\Graft.Instrumentation.Analyzer\Graft.Instrumentation.Analyzer.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <!-- NuGet: auto-import as package-id props/targets (buildTransitive). Source names stay Graft.*. -->
  <ItemGroup>
    <None Include="build\Graft.props" Pack="true" PackagePath="buildTransitive\Graft.Instrumentation.Wpf.props" />
    <None Include="build\Graft.targets" Pack="true" PackagePath="buildTransitive\Graft.Instrumentation.Wpf.targets" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
</Project>
