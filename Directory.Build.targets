<Project>
  <!--
    Consumers that reference Graft.Instrumentation or Graft.Instrumentation.Wpf get GRAFT001.
    Direct references do not import the WPF package targets, so the analyzer is attached here.
    Item metadata is only legal inside a target (MSB4190 at evaluation time).
  -->
  <Target Name="AddGraft001Analyzer" BeforeTargets="AssignProjectConfiguration">
    <ItemGroup>
      <_GraftHost Include="@(ProjectReference)" Condition="'%(Filename)' == 'Graft.Instrumentation'" />
      <_GraftHost Include="@(ProjectReference)" Condition="'%(Filename)' == 'Graft.Instrumentation.Wpf'" />
      <_GraftAnalyzer Include="@(ProjectReference)" Condition="'%(Filename)' == 'Graft.Instrumentation.Analyzer'" />
    </ItemGroup>
    <ItemGroup Condition="'@(_GraftHost)' != '' AND '@(_GraftAnalyzer)' == ''">
      <ProjectReference Include="$(MSBuildThisFileDirectory)src\Graft.Instrumentation.Analyzer\Graft.Instrumentation.Analyzer.csproj">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <OutputItemType>Analyzer</OutputItemType>
        <PrivateAssets>all</PrivateAssets>
      </ProjectReference>
    </ItemGroup>
  </Target>
  <!--
    Project references exclude analyzer assets from the generated nuspec, so
    pack the GRAFT001 DLL into the packages that apps actually reference.
  -->
  <Target Name="IncludeGraftAnalyzerInPackage" BeforeTargets="_GetPackageFiles" Condition="'$(GraftEmbedAnalyzer)' == 'true'">
    <PropertyGroup>
      <_GraftAnalyzerDll>$(MSBuildProjectDirectory)\..\Graft.Instrumentation.Analyzer\bin\$(Configuration)\netstandard2.0\Graft.Instrumentation.Analyzer.dll</_GraftAnalyzerDll>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_GraftAnalyzerDll)')"
      Text="Graft.Instrumentation.Analyzer.dll is missing for $(Configuration). Pack with -c GraftTest."
    />
    <ItemGroup>
      <None Include="$(_GraftAnalyzerDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
