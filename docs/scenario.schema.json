{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graft.dev/schemas/scenario.schema.json",
  "title": "Graft Scenario",
  "description": "Declarative UI E2E scenario (exchange format). Compiled by Graft.Core into an operation list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "steps"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Scenario document version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional human-readable scenario name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/launch"
        },
        {
          "$ref": "#/$defs/invoke"
        },
        {
          "$ref": "#/$defs/rightClick"
        },
        {
          "$ref": "#/$defs/doubleClick"
        },
        {
          "$ref": "#/$defs/hover"
        },
        {
          "$ref": "#/$defs/drag"
        },
        {
          "$ref": "#/$defs/clickAt"
        },
        {
          "$ref": "#/$defs/wheel"
        },
        {
          "$ref": "#/$defs/setValue"
        },
        {
          "$ref": "#/$defs/toggle"
        },
        {
          "$ref": "#/$defs/sendKeys"
        },
        {
          "$ref": "#/$defs/typeHuman"
        },
        {
          "$ref": "#/$defs/pressKeys"
        },
        {
          "$ref": "#/$defs/screenshot"
        },
        {
          "$ref": "#/$defs/scrollIntoView"
        },
        {
