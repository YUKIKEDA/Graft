    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "appPath"
      ],
      "properties": {
        "action": {
          "const": "launch"
        },
        "appPath": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
