{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graft.dev/schemas/scenario.schema.json",
  "title": "Graft Scenario",
  "description": "Declarative UI E2E scenario (exchange format). Compiled by Graft.Core into an operation list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "steps"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Scenario document version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional human-readable scenario name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/launch" },
        { "$ref": "#/$defs/invoke" },
        { "$ref": "#/$defs/rightClick" },
        { "$ref": "#/$defs/setValue" },
        { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/sendKeys" },
        { "$ref": "#/$defs/pressKeys" },
        { "$ref": "#/$defs/screenshot" },
        { "$ref": "#/$defs/scrollIntoView" },
        { "$ref": "#/$defs/select" },
        { "$ref": "#/$defs/selectMany" },
        { "$ref": "#/$defs/expand" },
        { "$ref": "#/$defs/collapse" },
        { "$ref": "#/$defs/expectName" },
        { "$ref": "#/$defs/expectSelected" },
        { "$ref": "#/$defs/expectExpanded" },
        { "$ref": "#/$defs/expectChecked" },
        { "$ref": "#/$defs/expectEnabled" },
        { "$ref": "#/$defs/expectVisible" },
        { "$ref": "#/$defs/expectNameContains" },
        { "$ref": "#/$defs/expectNameMatches" },
        { "$ref": "#/$defs/expectValue" },
        { "$ref": "#/$defs/waitFor" },
        { "$ref": "#/$defs/expectGone" },
        { "$ref": "#/$defs/getCellText" },
        { "$ref": "#/$defs/setCellValue" },
        { "$ref": "#/$defs/expectCellText" },
        { "$ref": "#/$defs/armOpenFile" },
        { "$ref": "#/$defs/armOpenFileCancel" },
        { "$ref": "#/$defs/armSaveFile" },
        { "$ref": "#/$defs/armSaveFileCancel" },
        { "$ref": "#/$defs/armOpenFolder" },
        { "$ref": "#/$defs/armOpenFolderCancel" },
        { "$ref": "#/$defs/armMessageBox" },
        { "$ref": "#/$defs/listWindows" },
        { "$ref": "#/$defs/switchWindow" },
        { "$ref": "#/$defs/waitForWindow" },
        { "$ref": "#/$defs/waitForWindowClosed" },
        { "$ref": "#/$defs/invokeOpeningWindow" }
      ]
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "appPath"],
      "properties": {
        "action": { "const": "launch" },
        "appPath": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "invoke" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "rightClick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "rightClick" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "setValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "value"],
      "properties": {
        "action": { "const": "setValue" },
        "automationId": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "toggle" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "sendKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "text"],
      "properties": {
        "action": { "const": "sendKeys" },
        "automationId": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "pressKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "keys"],
      "properties": {
        "action": { "const": "pressKeys" },
        "automationId": { "type": "string", "minLength": 1 },
        "keys": { "type": "string", "minLength": 1 }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path"],
      "properties": {
        "action": { "const": "screenshot" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "scrollIntoView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "scrollIntoView" },
        "automationId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "index"],
      "properties": {
        "action": { "const": "select" },
        "automationId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "selectMany": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "indexes"],
      "properties": {
        "action": { "const": "selectMany" },
        "automationId": { "type": "string", "minLength": 1 },
        "indexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "expand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "expand" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "collapse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "collapse" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "expectName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "name"],
      "properties": {
        "action": { "const": "expectName" },
        "automationId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "expectSelected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "selected"],
      "properties": {
        "action": { "const": "expectSelected" },
        "automationId": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" }
      }
    },
    "expectExpanded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "expanded"],
      "properties": {
        "action": { "const": "expectExpanded" },
        "automationId": { "type": "string", "minLength": 1 },
        "expanded": { "type": "boolean" }
      }
    },
    "expectChecked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "checked"],
      "properties": {
        "action": { "const": "expectChecked" },
        "automationId": { "type": "string", "minLength": 1 },
        "checked": { "type": "boolean" }
      }
    },
    "expectEnabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "enabled"],
      "properties": {
        "action": { "const": "expectEnabled" },
        "automationId": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "expectVisible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "visible"],
      "properties": {
        "action": { "const": "expectVisible" },
        "automationId": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" }
      }
    },
    "expectNameContains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "substring"],
      "properties": {
        "action": { "const": "expectNameContains" },
        "automationId": { "type": "string", "minLength": 1 },
        "substring": { "type": "string" }
      }
    },
    "expectNameMatches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "pattern"],
      "properties": {
        "action": { "const": "expectNameMatches" },
        "automationId": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "expectValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "value"],
      "properties": {
        "action": { "const": "expectValue" },
        "automationId": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "waitFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "waitFor" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "expectGone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "expectGone" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "getCellText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "row"],
      "properties": {
        "action": { "const": "getCellText" },
        "automationId": { "type": "string", "minLength": 1 },
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "columnKey": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["column"], "not": { "required": ["columnKey"] } },
        { "required": ["columnKey"], "not": { "required": ["column"] } }
      ]
    },
    "setCellValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "row", "value"],
      "properties": {
        "action": { "const": "setCellValue" },
        "automationId": { "type": "string", "minLength": 1 },
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "columnKey": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "oneOf": [
        { "required": ["column"], "not": { "required": ["columnKey"] } },
        { "required": ["columnKey"], "not": { "required": ["column"] } }
      ]
    },
    "expectCellText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "row", "text"],
      "properties": {
        "action": { "const": "expectCellText" },
        "automationId": { "type": "string", "minLength": 1 },
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "columnKey": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      },
      "oneOf": [
        { "required": ["column"], "not": { "required": ["columnKey"] } },
        { "required": ["columnKey"], "not": { "required": ["column"] } }
      ]
    },
    "listWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "listWindows" }
      }
    },
    "switchWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "windowId"],
      "properties": {
        "action": { "const": "switchWindow" },
        "windowId": { "type": "integer" }
      }
    },
    "waitForWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "waitForWindow" },
        "title": { "type": "string", "minLength": 1 },
        "automationId": { "type": "string", "minLength": 1 },
        "switchTo": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["title"] },
        { "required": ["automationId"] }
      ]
    },
    "waitForWindowClosed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "waitForWindowClosed" },
        "title": { "type": "string", "minLength": 1 },
        "automationId": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["title"] },
        { "required": ["automationId"] }
      ]
    },
    "armOpenFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path"],
      "properties": {
        "action": { "const": "armOpenFile" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "armOpenFileCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "armOpenFileCancel" }
      }
    },
    "armSaveFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path"],
      "properties": {
        "action": { "const": "armSaveFile" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "armSaveFileCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "armSaveFileCancel" }
      }
    },
    "armOpenFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path"],
      "properties": {
        "action": { "const": "armOpenFolder" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "armOpenFolderCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "const": "armOpenFolderCancel" }
      }
    },
    "armMessageBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "result"],
      "properties": {
        "action": { "const": "armMessageBox" },
        "result": {
          "type": "string",
          "enum": ["None", "OK", "Cancel", "Yes", "No"]
        }
      }
    },
    "invokeOpeningWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "invokeOpeningWindow" },
        "automationId": { "type": "string", "minLength": 1 },
        "waitForNewWindow": { "type": "boolean" }
      }
    }
  }
}
