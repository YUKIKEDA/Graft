{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graft.dev/schemas/scenario.schema.json",
  "title": "Graft Scenario",
  "description": "Declarative UI E2E scenario (exchange format). Compiled by Graft.Core into an operation list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "steps"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Scenario document version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional human-readable scenario name."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/launch" },
        { "$ref": "#/$defs/invoke" },
        { "$ref": "#/$defs/setValue" },
        { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/sendKeys" },
        { "$ref": "#/$defs/scrollIntoView" },
        { "$ref": "#/$defs/select" },
        { "$ref": "#/$defs/expand" },
        { "$ref": "#/$defs/collapse" },
        { "$ref": "#/$defs/expectName" }
      ]
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "appPath"],
      "properties": {
        "action": { "const": "launch" },
        "appPath": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "invoke" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "setValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "value"],
      "properties": {
        "action": { "const": "setValue" },
        "automationId": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "toggle" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "sendKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "text"],
      "properties": {
        "action": { "const": "sendKeys" },
        "automationId": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "scrollIntoView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "scrollIntoView" },
        "automationId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "index"],
      "properties": {
        "action": { "const": "select" },
        "automationId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "expand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "expand" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "collapse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId"],
      "properties": {
        "action": { "const": "collapse" },
        "automationId": { "type": "string", "minLength": 1 }
      }
    },
    "expectName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "automationId", "name"],
      "properties": {
        "action": { "const": "expectName" },
        "automationId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    }
  }
}
