<UserControl x:Class="SampleTodoApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="SettingsView">
    <Border Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="2"
            CornerRadius="4"
            Padding="24"
            MinWidth="540"
            MaxWidth="680">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,20">
                <TextBlock Text="設定" Style="{DynamicResource AppTitleText}" />
                <TextBlock Text="保存先と表示テーマを変更できます"
                           Style="{DynamicResource AppSectionLabel}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="データ保存先"
                       Style="{DynamicResource AppSectionLabel}"
                       Margin="0,0,0,16" />
            <TextBox x:Name="DataDirectoryText"
                     Grid.Row="1"
                     Grid.Column="1"
                     AutomationProperties.AutomationId="SettingsDataDirectoryText"
                     Margin="0,0,8,16"
                     IsReadOnly="True"
                     Text="{Binding DataDirectory.Value}" />
            <Button x:Name="BrowseDataDirectoryButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SettingsBrowseDataDirectoryButton"
                    Content="参照…"
                    Margin="0,0,0,16"
                    Command="{Binding BrowseDataDirectoryCommand}" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="テーマ"
                       Style="{DynamicResource AppSectionLabel}"
                       Margin="0,0,0,20" />
            <CheckBox x:Name="DarkThemeCheckBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      AutomationProperties.AutomationId="SettingsDarkThemeCheckBox"
                      Content="ダークテーマを使う"
                      Margin="0,0,0,20"
                      IsChecked="{Binding IsDarkTheme.Value, Mode=TwoWay}" />

            <Button x:Name="CloseButton"
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    AutomationProperties.AutomationId="SettingsCloseButton"
                    Style="{DynamicResource AccentButton}"
                    Content="閉じる"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Border>
</UserControl>
