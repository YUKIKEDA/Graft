<Window x:Class="SampleTodoApp.Views.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        AutomationProperties.AutomationId="DetailWindow"
        Width="460"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="{Binding WindowTitle}"
                   Style="{DynamicResource AppTitleText}"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Title"
                   Style="{DynamicResource AppSectionLabel}"
                   Margin="0,0,0,12" />
        <TextBox x:Name="TitleBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 AutomationProperties.AutomationId="DetailTitleBox"
                 Margin="0,0,0,12"
                 Text="{Binding Title.Value, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Status"
                   Style="{DynamicResource AppSectionLabel}"
                   Margin="0,0,0,12" />
        <ComboBox x:Name="StatusCombo"
                  Grid.Row="2"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="DetailStatusCombo"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding Status.Value}" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Priority"
                   Style="{DynamicResource AppSectionLabel}"
                   Margin="0,0,0,12" />
        <ComboBox x:Name="PriorityCombo"
                  Grid.Row="3"
                  Grid.Column="1"
                  AutomationProperties.AutomationId="DetailPriorityCombo"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding PriorityOptions}"
                  SelectedItem="{Binding Priority.Value}" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    AutomationProperties.AutomationId="DetailSaveButton"
                    Style="{DynamicResource AccentButton}"
                    Content="保存"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
            <Button x:Name="CancelButton"
                    AutomationProperties.AutomationId="DetailCancelButton"
                    Content="キャンセル"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
