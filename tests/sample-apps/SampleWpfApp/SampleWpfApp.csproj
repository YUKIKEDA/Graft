<Project Sdk="Microsoft.NET.Sdk">
  <!-- ProjectReference does not auto-import NuGet buildTransitive; import Graft MSBuild explicitly. -->
  <Import Project="..\..\..\src\Graft.Instrumentation.Wpf\build\Graft.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SampleWpfApp</RootNamespace>
    <AssemblyName>SampleWpfApp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Graft.Instrumentation.Wpf\Graft.Instrumentation.Wpf.csproj" />
  </ItemGroup>
  <Import Project="..\..\..\src\Graft.Instrumentation.Wpf\build\Graft.targets" />
</Project>
