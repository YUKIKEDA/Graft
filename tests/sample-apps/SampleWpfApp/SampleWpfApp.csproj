<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SampleWpfApp</RootNamespace>
    <AssemblyName>SampleWpfApp</AssemblyName>
  </PropertyGroup>
  <!-- Batch 1: local GraftTest configuration. Full Graft.props/targets arrive in M1. -->
  <PropertyGroup Condition="'$(Configuration)' == 'GraftTest'">
    <DefineConstants>$(DefineConstants);GRAFT_TEST</DefineConstants>
  </PropertyGroup>
  <!-- Also allow: dotnet build -p:GraftTest=true -->
  <PropertyGroup Condition="'$(GraftTest)' == 'true'">
    <DefineConstants>$(DefineConstants);GRAFT_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Graft.Instrumentation.Wpf\Graft.Instrumentation.Wpf.csproj" />
  </ItemGroup>
</Project>
